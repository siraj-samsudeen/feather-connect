# Copy to .env (git-ignored) and adjust. Variables already set in the
# environment win over this file.

# The Postgres 18 database: the development container of compose.yaml.
# The container creates the database "feather" on its first start; a worktree
# uses its own, set up with: uv run scripts/worktree_env.py <n>
FCON_DATABASE_URL=postgresql://feather:feather@127.0.0.1:5442/feather

# The secret key every install needs, at least 32 random characters; a
# worktree's .env gets one from scripts/worktree_env.py. Make one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# FCON_SECRET_KEY=<at least 32 random characters>

# While the secret key is changed: the old one, so open sign-in forms still work.
# FCON_SECRET_KEY_PREVIOUS=<the old key>

# Makes this user the first administrator, with a one-time password in the
# server's log, when the server starts with no users. Or, without it:
# uv run fcon users add <name>   (the password is asked for; it is yours to keep)
# FCON_FIRST_ADMIN=admin@example.com

# The install's name, shown on every page (default: development).
# FCON_ENVIRONMENT=development

# The proxies whose X-Forwarded-For is believed: addresses or ranges,
# comma-separated, or * (default: none). Not needed on this machine.
# FCON_TRUSTED_PROXIES=127.0.0.1

# The owner's address, for fcon db upgrade only (default: FCON_DATABASE_URL).
# With a different user from FCON_DATABASE_URL's, each upgrade grants that
# user read and write on the tables, and only read and add on the audit log.
# FCON_MIGRATION_DATABASE_URL=postgresql://feather_owner:secret@127.0.0.1:5442/feather

# The server's connections to the database (default: 5).
# FCON_DATABASE_POOL_SIZE=5

# off when a connection pooler sits in front of Postgres (default: on).
# FCON_DATABASE_PREPARE=on

# Where the server listens (defaults: 127.0.0.1 and 8080).
# FCON_HOST=127.0.0.1
# FCON_PORT=8080

# Log format: text or json (default: text on a terminal, json elsewhere).
# FCON_LOG_FORMAT=text

# The acceptance suite's port.
# ACCEPTANCE_PORT=8030
