# Copy to .env (git-ignored) and adjust. Variables already set in the
# environment win over this file.

# The Postgres 18 database: the development container of compose.yaml.
# The container creates the database "feather" on its first start; a worktree
# uses its own: docker compose exec db createdb -U feather feather_issue_<n>
FEATHER_DATABASE_URL=postgresql://feather:feather@127.0.0.1:5442/feather

# Where the server listens (defaults: 127.0.0.1 and 8080).
# FEATHER_HOST=127.0.0.1
# FEATHER_PORT=8080

# Log format: text or json (default: text on a terminal, json elsewhere).
# FEATHER_LOG_FORMAT=text

# The acceptance suite's port.
# ACCEPTANCE_PORT=8030
