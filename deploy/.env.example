# The settings of the standard setup (deploy/compose.yaml).
# Copy this file to deploy/.env and fill it in. deploy/.env holds passwords: never put it in git.
#
# The database administrator makes the database fcon and its two users once (docs/deploy.md).
# Long random passwords in hex are suggested, for example: openssl rand -hex 32
# Any other password: percent-escape it in the address (@ is %40), and write $ as $$ here.

# The site's name. It must point at this machine, and ports 80 and 443 must reach it,
# so Caddy can get the certificate.
FCON_DOMAIN=connect.example.com

# The owner user's address: the upgrade runs as it, before the product starts.
FCON_MIGRATION_DATABASE_URL=postgresql://fcon:<owner-password>@host.docker.internal:5432/fcon

# The app user's address: the product runs as it.
FCON_DATABASE_URL=postgresql://fcon_app:<app-password>@host.docker.internal:5432/fcon

# The secret key that signs the sign-in form, at least 32 random characters. Make one with:
# openssl rand -hex 32
FCON_SECRET_KEY=<secret-key>
